# Prisma ORM + SQLite. O arquivo do banco será criado em prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Gere uma chave forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="substitua-por-uma-chave-aleatoria-forte"

PORT=3000

# Opcional: notificações por e-mail ao criar um prato (funcionalidade anterior)
RESEND_API_KEY=""
EMAIL_FROM="EasyFood <onboarding@resend.dev>"
APP_BASE_URL="http://localhost:3000"
